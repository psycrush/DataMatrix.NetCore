<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net461;netstandard2.0;netstandard2.1</TargetFrameworks>
		<PackageId>DataMatrix.NetCore</PackageId>
	</PropertyGroup>

 <!-- On .NET Framework the System.Drawing types come from the framework assembly
		 including the NuGet package causes duplicate type errors (System.Drawing vs System.Drawing.Common).
		 Only reference System.Drawing.Common for non-.NET Framework targets. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net461'">
		<PackageReference Include="System.Drawing.Common" Version="10.0.5" />
	</ItemGroup>

</Project>
